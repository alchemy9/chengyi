# 复制成 .env；scripts/bootstrap.py 会生成本地管理员密码和签名密钥。
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/heritage.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=
# 网页由本服务托管时同源访问，不需要跨域；用 tools/serve.py 单独预览网页（5180 端口）时才用到。
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
SEED_DEMO_DATA=true

# demo 不需要 Key；联调真实模型时改成 live，并填写下面三个配置。
LLM_MODE=demo
LLM_PROVIDER=dify
LLM_API_BASE_URL=https://api.dify.ai/v1
LLM_API_KEY=
LLM_MODEL=非遗讲解人
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200
# 模型故障时改用资料讲解，并在返回中明确标记 fallback。
LLM_FALLBACK_ENABLED=true

# 硅基流动语音：朗读回复与按住说话的转写。
SPEECH_ENABLED=false
SPEECH_API_KEY=
SPEECH_VOICE=anna
SPEECH_TIMEOUT_SECONDS=45
